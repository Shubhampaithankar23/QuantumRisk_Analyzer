# Local development: Relative /api/v1 routes through Next.js proxy rewrite (works on phone, laptop, and local LAN)
NEXT_PUBLIC_API_URL=/api/v1
BACKEND_URL=http://127.0.0.1:4000/api/v1

# Cloud production (e.g. Vercel deployment pointing to Render backend):
# NEXT_PUBLIC_API_URL=https://quantumrisk-backend.onrender.com/api/v1
